    saveButton.addEventListener("click", (event) => {{
      event.preventDefault();
      saveContent();
    }});

    window.addEventListener("keydown", (event) => {{
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "s") {{
        event.preventDefault();
        saveContent();
      }}
    }});

    loadContent();
  </script>
