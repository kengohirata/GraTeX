#!/usr/bin/env python3
"""Launch a lightweight local editor page in Chrome so Grammarly can assist."""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import shutil
import signal
import socketserver
import subprocess
import sys
import threading
import time
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, HTTPServer
from typing import Callable


HTML_TEMPLATE = """<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Editing {display_name}</title>
  <style>
    :root {{
      color-scheme: light dark;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }}
    body {{
      margin: 0;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      background: #101418;
      color: #e2e8f0;
    }}
    header {{
      padding: 1rem 1.5rem;
      background: #1f2933;
      border-bottom: 1px solid #374151;
      font-weight: 600;
    }}
    main {{
      flex: 1;
      display: flex;
      flex-direction: column;
      padding: 1rem;
      gap: 0.75rem;
    }}
    textarea {{
      flex: 1;
      width: 100%;
      resize: both;
      min-height: 300px;
      border-radius: 0.5rem;
      border: 1px solid #374151;
      padding: 1rem;
      font: 16px/1.6 "SF Mono", ui-monospace, Menlo, Consolas, monospace;
      background: #0b1015;
      color: inherit;
      box-sizing: border-box;
      outline: none;
    }}
    textarea:focus {{
      border-color: #3b82f6;
      box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.25);
    }}
    .toolbar {{
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }}
    button {{
      font: inherit;
      padding: 0.5rem 1rem;
      border-radius: 0.5rem;
      border: 1px solid #2563eb;
      background: #2563eb;
